<Window x:Class="DelayForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DelayForge — Network Impairment Tool" Height="700" Width="900"
        MinHeight="550" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#FFF1F5F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== Header ========== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Logo -->
                <Border Width="40" Height="40" CornerRadius="10" Background="#FF2563EB" Margin="0,0,12,0">
                    <TextBlock Text="⚒" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DelayForge" FontSize="22" FontWeight="Bold" Foreground="#FF0F172A"/>
                    <TextBlock Text="Network Impairment Tool" FontSize="11" Foreground="#FF94A3B8" Margin="0,-2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Start / Stop Button -->
            <Button x:Name="BtnToggle" Grid.Column="2" Style="{StaticResource ToggleBtn}"
                    Width="160" Click="BtnToggle_Click">
                <TextBlock x:Name="BtnLabel" Text="▶  Start" FontWeight="SemiBold" FontSize="16" Foreground="White"/>
            </Button>
        </Grid>

        <!-- ========== Content: 2-column layout ========== -->
        <Grid Grid.Row="1" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Damage Parameters -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Latency -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="⏱  Latency"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderLatency" Grid.Column="0" Minimum="0" Maximum="3000"
                                        Value="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                        ValueChanged="SliderLatency_ValueChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtLatency" Width="50" Text="0" TextAlignment="Center"
                                             VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                             Margin="0,0,2,0" LostFocus="TxtLatency_LostFocus"/>
                                    <TextBlock Text="ms" VerticalAlignment="Center" Foreground="#FF64748B"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Jitter -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="〰  Jitter"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderJitter" Grid.Column="0" Minimum="0" Maximum="500"
                                        Value="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                        ValueChanged="SliderJitter_ValueChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtJitter" Width="50" Text="0" TextAlignment="Center"
                                             VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                             Margin="0,0,2,0" LostFocus="TxtJitter_LostFocus"/>
                                    <TextBlock Text="±ms" VerticalAlignment="Center" Foreground="#FF64748B"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Packet Loss -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="✕  Packet Loss"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderLoss" Grid.Column="0" Minimum="0" Maximum="100"
                                        Value="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                        ValueChanged="SliderLoss_ValueChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtLoss" Width="50" Text="0" TextAlignment="Center"
                                             VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                             Margin="0,0,2,0" LostFocus="TxtLoss_LostFocus"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Foreground="#FF64748B"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Duplicate -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="⧉  Duplicate"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderDuplicate" Grid.Column="0" Minimum="0" Maximum="50"
                                        Value="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                        ValueChanged="SliderDuplicate_ValueChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtDuplicate" Width="50" Text="0" TextAlignment="Center"
                                             VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                             Margin="0,0,2,0" LostFocus="TxtDuplicate_LostFocus"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Foreground="#FF64748B"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Reorder -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="⇅  Reorder"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderReorder" Grid.Column="0" Minimum="0" Maximum="50"
                                        Value="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                        ValueChanged="SliderReorder_ValueChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtReorder" Width="50" Text="0" TextAlignment="Center"
                                             VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                             Margin="0,0,2,0" LostFocus="TxtReorder_LostFocus"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Foreground="#FF64748B"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tamper -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="⚡  Tamper (Corrupt)"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderTamper" Grid.Column="0" Minimum="0" Maximum="50"
                                        Value="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                        ValueChanged="SliderTamper_ValueChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtTamper" Width="50" Text="0" TextAlignment="Center"
                                             VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                             Margin="0,0,2,0" LostFocus="TxtTamper_LostFocus"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Foreground="#FF64748B"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Throttle -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="🔒  Bandwidth Throttle"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderThrottle" Grid.Column="0" Minimum="0" Maximum="10000"
                                        Value="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                        ValueChanged="SliderThrottle_ValueChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtThrottle" Width="50" Text="0" TextAlignment="Center"
                                             VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                             Margin="0,0,2,0" LostFocus="TxtThrottle_LostFocus"/>
                                    <TextBlock Text="kbps" VerticalAlignment="Center" Foreground="#FF64748B"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Filters + Stats -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Filters -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="🔍  Filter Rules"/>

                            <TextBlock Text="Direction" FontSize="12" Foreground="#FF64748B" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbDirection" Margin="0,0,0,12" SelectedIndex="0">
                                <ComboBoxItem Content="Both (Inbound + Outbound)"/>
                                <ComboBoxItem Content="Outbound Only"/>
                                <ComboBoxItem Content="Inbound Only"/>
                            </ComboBox>

                            <TextBlock Text="Protocol" FontSize="12" Foreground="#FF64748B" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbProtocol" Margin="0,0,0,12" SelectedIndex="0">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="TCP Only"/>
                                <ComboBoxItem Content="UDP Only"/>
                                <ComboBoxItem Content="ICMP Only"/>
                            </ComboBox>

                            <TextBlock Text="Process Name (e.g. chrome.exe)" FontSize="12" Foreground="#FF64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtProcessFilter" Margin="0,0,0,12" FontSize="13"
                                     VerticalContentAlignment="Center" Padding="6,4"/>

                            <TextBlock Text="IP Address / CIDR (comma-separated)" FontSize="12" Foreground="#FF64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtIpFilter" Margin="0,0,0,12" FontSize="13"
                                     VerticalContentAlignment="Center" Padding="6,4"/>

                            <TextBlock Text="Port (comma-separated)" FontSize="12" Foreground="#FF64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPortFilter" Margin="0,0,0,12" FontSize="13"
                                     VerticalContentAlignment="Center" Padding="6,4"/>

                            <!-- WinDivert filter preview -->
                            <TextBlock Text="WinDivert Filter:" FontSize="11" Foreground="#FF94A3B8" Margin="0,4,0,2"/>
                            <Border Background="#FFF8FAFC" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                <TextBlock x:Name="TxtFilterPreview" FontSize="12" FontFamily="Consolas"
                                           Foreground="#FF334155" Text="true" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Statistics -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="📊  Live Statistics"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Packets Processed:" Foreground="#FF64748B" FontSize="12"/>
                                <TextBlock x:Name="StatProcessed" Grid.Row="0" Grid.Column="1" Text="0" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Bytes Processed:" Foreground="#FF64748B" FontSize="12"/>
                                <TextBlock x:Name="StatBytes" Grid.Row="1" Grid.Column="1" Text="0 B" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Delayed:" Foreground="#FF64748B" FontSize="12"/>
                                <TextBlock x:Name="StatDelayed" Grid.Row="2" Grid.Column="1" Text="0" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Foreground="#FF2563EB"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Dropped:" Foreground="#FF64748B" FontSize="12"/>
                                <TextBlock x:Name="StatDropped" Grid.Row="3" Grid.Column="1" Text="0" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Foreground="#FFDC2626"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Duplicated:" Foreground="#FF64748B" FontSize="12"/>
                                <TextBlock x:Name="StatDuplicated" Grid.Row="4" Grid.Column="1" Text="0" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Foreground="#FFF59E0B"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Reordered:" Foreground="#FF64748B" FontSize="12"/>
                                <TextBlock x:Name="StatReordered" Grid.Row="5" Grid.Column="1" Text="0" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Foreground="#FF8B5CF6"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Tampered:" Foreground="#FF64748B" FontSize="12"/>
                                <TextBlock x:Name="StatTampered" Grid.Row="6" Grid.Column="1" Text="0" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Foreground="#FF06B6D4"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Queue Depth:" Foreground="#FF64748B" FontSize="12"/>
                                <TextBlock x:Name="StatQueueDepth" Grid.Row="7" Grid.Column="1" Text="0" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
